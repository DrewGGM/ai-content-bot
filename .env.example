# ===== API KEYS — Content Bot =====
# Copia este archivo a .env y rellena los valores. NO commitear .env.

# --- CEREBRO del bot: copy, planner, edicion y QA visual ---
# Elige COMO escribe el bot. Puede ser un agente CLI (usa tu suscripcion / su propio login)
# o una API directa con key. Ver README ("Elige tu agente o API") para la tabla completa.
#
#   claude    -> Claude Code CLI (default; suscripcion, sin API key)
#   codex     -> OpenAI Codex CLI (codex exec; login ChatGPT o API key)
#   gemini    -> Google Gemini CLI (login Google o GEMINI_API_KEY)
#   qwen      -> Qwen Code CLI (OPENAI_API_KEY/OPENAI_BASE_URL o DASHSCOPE_API_KEY)
#   kimi      -> Kimi Code CLI de Moonshot (login Kimi o API key en su config.toml)
#   cursor    -> Cursor CLI (cursor-agent; CURSOR_API_KEY o login)
#   copilot   -> GitHub Copilot CLI (login GitHub)
#   opencode  -> OpenCode CLI (multi-proveedor, incluye modelos locales)
#   custom    -> CUALQUIER agente: define AGENT_CMD (recibe el prompt por stdin, responde por stdout)
#   anthropic -> Anthropic Messages API con ANTHROPIC_API_KEY (tambien endpoints compatibles
#                via ANTHROPIC_BASE_URL: Kimi/Moonshot, GLM/Z.AI, DeepSeek, MiniMax)
#   openai    -> cualquier endpoint compatible con OpenAI chat/completions via LLM_BASE_URL
#                (OpenAI, OpenRouter, Kimi/Moonshot, DeepSeek, Groq, Ollama local, GLM...)
COPY_PROVIDER=claude
# Modelo (opcional; cada proveedor tiene su default: claude->sonnet, anthropic->claude-sonnet-4-5,
# openai->gpt-4o-mini; en CLIs vacio = el modelo configurado en el propio CLI)
COPY_MODEL=
# Timeout por llamada al agente/API (ms). Default 300000 (5 min).
COPY_TIMEOUT_MS=
# QA visual: por defecto cada proveedor sabe si puede VER imagenes (claude/codex/gemini/cursor/
# anthropic/openai si). Fuerza con true/false (ej. true si tu modelo qwen/kimi es multimodal;
# false si usas DeepSeek via anthropic-compatible, que no soporta imagenes).
COPY_VISION=

# Solo si COPY_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
# Endpoint alternativo compatible con Anthropic (opcional; la key va en ANTHROPIC_API_KEY). Ejemplos:
#   Kimi/Moonshot: https://api.moonshot.ai/anthropic      (COPY_MODEL=kimi-k2.7-code)
#   GLM / Z.AI:    https://api.z.ai/api/anthropic
#   DeepSeek:      https://api.deepseek.com/anthropic     (sin vision -> COPY_VISION=false)
#   MiniMax:       https://api.minimax.io/anthropic
ANTHROPIC_BASE_URL=

# Solo si COPY_PROVIDER=openai (endpoint compatible con OpenAI):
LLM_API_KEY=
# Ejemplos de LLM_BASE_URL (vacio = https://api.openai.com/v1):
#   OpenRouter: https://openrouter.ai/api/v1        (COPY_MODEL=anthropic/claude-sonnet-4.5, moonshotai/kimi-k2.5, ...)
#   Kimi:       https://api.moonshot.ai/v1           (COPY_MODEL=kimi-k2.5; vision con base64 OK)
#   DeepSeek:   https://api.deepseek.com             (COPY_MODEL=deepseek-chat; sin vision -> LLM_VISION=false)
#   Groq:       https://api.groq.com/openai/v1
#   Ollama:     http://localhost:11434/v1            (local, gratis; LLM_API_KEY=ollama; COPY_MODEL=qwen3-vl, llava...)
LLM_BASE_URL=
# Pon false si tu modelo openai-compatible NO soporta imagenes (desactiva el QA visual limpio)
LLM_VISION=true

# Solo si COPY_PROVIDER=custom: comando de tu agente (prompt por stdin -> respuesta por stdout)
# Ej: AGENT_CMD=aider --message-file - --yes --no-auto-commits
AGENT_CMD=
# true si tu agente custom puede LEER imagenes del disco (habilita el QA visual)
AGENT_VISION=false

# --- Voz / locucion ---
ELEVENLABS_API_KEY=

# --- Imagen: proveedor (fal | openai | gemini) ---
IMAGE_PROVIDER=fal
FAL_KEY=

# --- Activar/desactivar proveedores (tambien desde Ajustes del panel) ---
# Apagan un servicio de pago SIN borrar su key: el planner deja de elegir los formatos que
# dependen de el y el scheduler cae a lo disponible (design). true = activado (default).
ENABLE_FAL=true       # imagenes por fal + video b-roll (reel) + avatar OmniHuman
ENABLE_VIDEO=true     # solo el reel de video b-roll (image-to-video), sin tocar imagenes
ENABLE_VOICE=true     # voz de ElevenLabs (off => motion cae a musica/silencio, reel no disponible)
ENABLE_HEYGEN=true    # formato UGC (avatar hablando)
ENABLE_ADS=true       # modulo de campanas de ads de Meta (off => oculto y bloqueado en el panel)
# Solo si usas IMAGE_PROVIDER=openai
OPENAI_API_KEY=
# Solo si usas IMAGE_PROVIDER=gemini
GEMINI_API_KEY=

# --- Publicacion: Instagram + Facebook (Meta Graph API) ---
# Requiere cuenta IG Business ligada a una Pagina de FB + app en Meta Developers.
# INSTAGRAM_ACCESS_TOKEN = token de PAGINA de larga duracion (sirve para IG y FB).
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
# Opcional: token de pagina distinto para FB (si no, usa INSTAGRAM_ACCESS_TOKEN)
FACEBOOK_PAGE_TOKEN=
# Bucle de rendimiento: tras publicar, el bot mide alcance/guardados/compartidos y prioriza lo que
# funciono. El score fino necesita el permiso instagram_manage_insights en el token; sin el, cae a
# like_count/comments_count. Horas de espera antes de medir (tambien en Ajustes del panel):
INSIGHTS_MIN_AGE_HOURS=48

# --- Publicacion: TikTok (Content Posting API, Direct Post) ---
# El flujo OAuth (con CLIENT_KEY/SECRET y scope video.publish) es del usuario; el bot publica con
# el access token resultante. La media se sube por URL publica (PULL_FROM_URL): el dominio del
# S3_PUBLIC_BASE debe estar verificado en el portal de TikTok si tu app no esta auditada.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | SELF_ONLY (apps en sandbox: solo SELF_ONLY)
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# --- Notificaciones push (Web Push / VAPID) ---
# Opcional: si no las defines, se generan solas y se guardan en data/push.json. Para fijarlas
# (multi-instancia), genera un par con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com

# --- Publicacion: LinkedIn ---
LINKEDIN_ACCESS_TOKEN=

# --- Publicacion: X (Twitter) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Motor de video b-roll (kling | veo) ---
VIDEO_ENGINE=kling

# --- UGC con avatar (HeyGen) ---
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# --- Control de costo del QA visual ---
QA_ATTEMPTS=2
VIDEO_QA_ATTEMPTS=2

# --- Conocimiento de skills de community manager en el copy (true | false) ---
USE_CM_SKILLS=true

# --- Persistencia: cola/historial (local | d1) ---
QUEUE_STORE=local
# Solo si QUEUE_STORE=d1 (Cloudflare D1):
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# --- Persistencia: assets (local | s3) — S3 o Cloudflare R2 (compatible S3) ---
# OJO: si dejas esto SIN definir aqui, se puede cambiar local <-> R2 desde el panel
# (Ajustes -> Conexiones -> Almacenamiento). Si lo defines aqui, el .env manda y el panel
# lo muestra bloqueado. Lo mismo para las S3_* de abajo.
ASSET_STORE=local
# Solo si ASSET_STORE=s3:
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# S3_PUBLIC_BASE: dejar VACIO = bucket privado, los assets se sirven por el proxy /r2/ del
# panel (autenticado). Solo pon una URL publica (r2.dev o dominio propio) si quieres exponerlos.
S3_PUBLIC_BASE=

# --- Panel web de aprobacion ---
PANEL_PORT=4321
# El panel tiene LOGIN POR USUARIO (data/users.json): el primer arranque pide crear la
# cuenta admin desde el navegador. PANEL_PASSWORD (opcional) es el CODIGO DE INSTALACION
# que se exige en ese primer paso (evita que un extrano cree el admin antes que tu).
PANEL_PASSWORD=
# Clave maestra para CIFRAR las credenciales que los usuarios guardan en el panel
# (tokens de Claude Code, API keys). Si esta vacia, se genera una clave aleatoria en
# data/.secret-key. Recomendado: un string largo y estable (si lo cambias, los secretos
# guardados dejan de poder descifrarse y hay que volver a pegarlos).
PANEL_SECRET=

# Cron del SO (npm run schedule): con SCHEDULE_USER (nombre o id de un usuario del panel)
# la pieza diaria corre con SU agente/credenciales; vacio = configuracion del servidor.
# (La programacion 'Auto' del panel elige el dueno desde el propio modal.)
SCHEDULE_USER=
